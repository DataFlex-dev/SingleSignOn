Function g_Base64UrlEncodeStr Global String sData Returns String
    UChar[] ucaData
    
    Get g_Base64EncodeUCharArray (StringToUCharArray(sData)) to ucaData
    Move (UCharArrayToString(ucaData)) to sData
    Move (Replaces('+', sData, '-')) to sData
    Move (Replaces('/', sData, '_')) to sData
    Move (Replaces('=', sData, '')) to sData
    
    Function_Return sData
End_Function
    
Function g_Base64UrlDecodeStr Global String sData Returns String
    UChar[] ucaData
    Integer iRemainder
    
    Move (Replaces('-', sData, '+')) to sData
    Move (Replaces('_', sData, '/')) to sData

    // URL-safe Base64 omits the '=' padding characters. Restore them before
    // calling the Windows Base64 decoder; the PKCE verifier in the SSO state
    // commonly has a length that requires two padding characters.
    Move (Mod(SizeOfString(sData), 4)) to iRemainder
    If (iRemainder = 1) Begin
        Function_Return ""
    End
    Else If (iRemainder = 2) Begin
        Move (sData + "==") to sData
    End
    Else If (iRemainder = 3) Begin
        Move (sData + "=") to sData
    End

    Get g_Base64DecodeUCharArray (StringToUCharArray(sData)) to ucaData
    
    Function_Return (UCharArrayToString(ucaData))
End_Function
    
// base 64 Encode from Uchar array to a Uchar array
Function g_Base64EncodeUCharArray Global UChar[] UCharData Returns UChar[]
    Pointer pBase64
    Integer iLen
    Boolean bOk
    
    Move (SizeOfArray(UCharData)) to iLen
    If (iLen > 0) Begin
        Move (Base64Encode(AddressOf(UCharData), iLen)) to pBase64
        Move (CStringLength(pBase64)) to iLen
        Move (ResizeArray(UCharData,iLen)) to UCharData
        Move (MemCopy(AddressOf(UCharData),pBase64,iLen)) to bOk
        Move (Free(pBase64)) to bOk
    End
    
    Function_Return UCharData
End_Function

// base 64 Decode from Uchar array to a Uchar array
Function g_Base64DecodeUCharArray Global UChar[] UCharData Returns UChar[]
    Pointer pData
    Integer iLen
    Boolean bOk
    
    Move (SizeOfArray(UCharData)) to iLen
    If (iLen > 0) Begin
        Move 0 to UCharData[iLen]
        Move (Base64Decode(AddressOf(UCharData),&iLen)) to pData
        Move (ResizeArray(UCharData,iLen)) to UCharData
        Move (MemCopy(AddressOf(UCharData),pData,iLen)) to bOk
        Move (Free(pData)) to bOk
    End
    
    Function_Return UCharData
End_Function
    
Function g_Base64EncodeStr String sData Returns String
    Function_Return (UCharArrayToString(g_Base64EncodeUCharArray(StringToUCharArray(sData))))
End_Function

Function g_Base64DecodeStr String sData Returns String
    Function_Return (UCharArrayToString(g_Base64DecodeUCharArray(StringToUCharArray(sData))))
End_Function
